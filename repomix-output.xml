                </td>
              </tr>
            ) : (
              items.map((item) => (
                <tr key={item.id} className={`border-b hover:bg-gray-50 ${selectedIds.includes(item.id) ? 'bg-green-50' : ''}`}>
                  <td className="px-4 py-3 text-center">
